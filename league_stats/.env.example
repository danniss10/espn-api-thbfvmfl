# ESPN Fantasy Football League Configuration
# Copy this file to .env and fill in your values

# Your league ID (found in the URL of your league page)
LEAGUE_ID=

# For private leagues, you need these cookies from ESPN
# See: https://github.com/cwendt94/espn-api/wiki/Private-Leagues
ESPN_S2=
SWID=

# Optional: Starting year to analyze (defaults to 2018)
START_YEAR=
